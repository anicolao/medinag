rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAdministrator(administratorId) {
      return signedIn() && request.auth.uid == administratorId;
    }

    function administrator(administratorId) {
      return get(/databases/$(database)/documents/administrators/$(administratorId));
    }

    function publishedAdministrator(administratorId) {
      return signedIn()
        && administrator(administratorId).data.published == true;
    }

    function followsAdministrator(administratorId) {
      return signedIn()
        && administrator(administratorId).data.patientUid == request.auth.uid;
    }

    function validAdministrator(administratorId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'planName',
          'planCode',
          'published',
          'patientUid',
          'patientDisplayName',
          'snoozeIntervalMinutes',
          'escalationDeadlineMinutes',
          'maxReminders',
          'timeZone',
          'smsNumber',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'planName',
          'planCode',
          'published',
          'patientUid',
          'patientDisplayName',
          'snoozeIntervalMinutes',
          'escalationDeadlineMinutes',
          'maxReminders',
          'timeZone',
          'smsNumber',
          'publishedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == administratorId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.planName is string
        && request.resource.data.planName.size() > 0
        && request.resource.data.planName.size() <= 100
        && request.resource.data.planCode is string
        && request.resource.data.planCode.matches('^[A-Z0-9]{4}-[A-Z0-9]{4}$')
        && request.resource.data.published is bool
        && (request.resource.data.patientUid == null
          || request.resource.data.patientUid is string)
        && request.resource.data.patientDisplayName is string
        && request.resource.data.patientDisplayName.size() <= 100
        && request.resource.data.snoozeIntervalMinutes is int
        && request.resource.data.snoozeIntervalMinutes >= 1
        && request.resource.data.snoozeIntervalMinutes <= 60
        && request.resource.data.escalationDeadlineMinutes is int
        && request.resource.data.escalationDeadlineMinutes >= 5
        && request.resource.data.escalationDeadlineMinutes <= 240
        && request.resource.data.maxReminders is int
        && request.resource.data.maxReminders >= 1
        && request.resource.data.maxReminders <= 12
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() > 0
        && request.resource.data.timeZone.size() <= 100
        && request.resource.data.smsNumber is string
        && request.resource.data.smsNumber.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPatient(patientId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'followingAdministratorUid',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'followingAdministratorUid',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == patientId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && (request.resource.data.followingAdministratorUid == null
          || request.resource.data.followingAdministratorUid is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validDose() {
      return request.resource.data.keys().hasOnly([
          'medicationName',
          'scheduledTime',
          'daysOfWeek',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.medicationName is string
        && request.resource.data.medicationName.size() > 0
        && request.resource.data.medicationName.size() <= 100
        && request.resource.data.scheduledTime is string
        && request.resource.data.scheduledTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.daysOfWeek is list
        && request.resource.data.daysOfWeek.size() > 0
        && request.resource.data.daysOfWeek.size() <= 7
        && request.resource.data.daysOfWeek.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validMedicationEvent() {
      return request.resource.data.keys().hasOnly([
          'scheduleId',
          'medicationName',
          'scheduledTime',
          'status',
          'snoozeCount',
          'lastSnoozedAt',
          'completedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.scheduleId is string
        && request.resource.data.scheduleId.size() > 0
        && request.resource.data.medicationName is string
        && request.resource.data.medicationName.size() > 0
        && request.resource.data.medicationName.size() <= 100
        && request.resource.data.scheduledTime is timestamp
        && request.resource.data.status in ['pending', 'snoozed', 'completed']
        && request.resource.data.snoozeCount is int
        && request.resource.data.snoozeCount >= 0
        && (request.resource.data.lastSnoozedAt == null
          || request.resource.data.lastSnoozedAt is timestamp)
        && (request.resource.data.completedAt == null
          || request.resource.data.completedAt is timestamp)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPatientResponse() {
      return resource.data.status in ['pending', 'snoozed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'snoozeCount',
          'lastSnoozedAt',
          'completedAt',
          'updatedAt'
        ])
        && validMedicationEvent()
        && (
          (request.resource.data.status == 'snoozed'
            && request.resource.data.snoozeCount == resource.data.snoozeCount + 1
            && request.resource.data.lastSnoozedAt is timestamp
            && request.resource.data.completedAt == resource.data.completedAt)
          ||
          (request.resource.data.status == 'completed'
            && request.resource.data.snoozeCount == resource.data.snoozeCount
            && request.resource.data.lastSnoozedAt == resource.data.lastSnoozedAt
            && request.resource.data.completedAt is timestamp)
        );
    }

    function validPatientClaim(administratorId) {
      return signedIn()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'patientUid',
          'patientDisplayName',
          'updatedAt'
        ])
        && validAdministrator(administratorId)
        && (
          (resource.data.patientUid == null
            && request.resource.data.patientUid == request.auth.uid
            && request.resource.data.patientDisplayName is string
            && request.resource.data.patientDisplayName.size() > 0)
          ||
          (resource.data.patientUid == request.auth.uid
            && request.resource.data.patientUid == null
            && request.resource.data.patientDisplayName == '')
        );
    }

    match /administrators/{administratorId} {
      allow create: if ownsAdministrator(administratorId)
        && validAdministrator(administratorId);
      allow read: if ownsAdministrator(administratorId)
        || (signedIn() && resource.data.published == true)
        || (signedIn() && resource.data.patientUid == request.auth.uid);
      allow update: if (ownsAdministrator(administratorId)
          && validAdministrator(administratorId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.planCode == resource.data.planCode
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (request.resource.data.patientUid == resource.data.patientUid
              && request.resource.data.patientDisplayName
                == resource.data.patientDisplayName)
            || (resource.data.patientUid != null
              && request.resource.data.patientUid == null
              && request.resource.data.patientDisplayName == '')
          ))
        || validPatientClaim(administratorId);
      allow delete: if false;

      match /doses/{doseId} {
        allow read: if ownsAdministrator(administratorId)
          || publishedAdministrator(administratorId);
        allow create: if ownsAdministrator(administratorId) && validDose();
        allow update: if ownsAdministrator(administratorId)
          && validDose()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /medicationEvents/{eventId} {
        allow read: if ownsAdministrator(administratorId)
          || followsAdministrator(administratorId);
        allow create: if ownsAdministrator(administratorId)
          && validMedicationEvent();
        allow update: if (ownsAdministrator(administratorId)
            && validMedicationEvent()
            && request.resource.data.createdAt == resource.data.createdAt)
          || (followsAdministrator(administratorId) && validPatientResponse());
        allow delete: if false;
      }
    }

    match /patients/{patientId} {
      allow read: if signedIn() && request.auth.uid == patientId;
      allow create: if signedIn()
        && request.auth.uid == patientId
        && validPatient(patientId);
      allow update: if signedIn()
        && request.auth.uid == patientId
        && validPatient(patientId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Read-only compatibility for migrating previously captured administrator data.
    match /admins/{adminId}/schedules/{scheduleId} {
      allow read: if ownsAdministrator(adminId);
      allow write: if false;
    }

    match /households/{householdId} {
      allow read: if ownsAdministrator(householdId);
      allow write: if false;

      match /{document=**} {
        allow read: if ownsAdministrator(householdId);
        allow write: if false;
      }
    }
  }
}
